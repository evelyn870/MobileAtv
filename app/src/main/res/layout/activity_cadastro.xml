<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".CadastroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/azul"
        android:padding="20dp">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_margin="15dp"
        android:layout_marginTop="100dp"
        android:src="@drawable/outline_person" />


        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="354dp"
            android:layout_height="40dp"
            android:layout_margin="10dp"
            android:drawableEnd="@drawable/outline_person"
            android:hint="User Name"
            android:textColorHint="@color/white"
            android:inputType="text"

            />


    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:drawableEnd="@drawable/outline_check"
        android:hint="Password"
        android:textColorHint="@color/white"

        />


    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:drawableEnd="@drawable/outline_attach_email"
        android:hint="Email"
        android:textColorHint="@color/white"
        android:inputType="textEmailAddress" />

    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:drawableEnd="@drawable/outline_add_call"
        android:hint="Phone"
        android:textColorHint="@color/white"
        android:inputType="phone" />


    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:textColorHint="@color/white"
        android:text="Allow terms and conditions" />


    <Button

        android:layout_width="280dp"
        android:layout_height="67dp"
        android:layout_margin="20dp"
        android:layout_marginTop="50dp"
        android:textColorHint="@color/white"
        android:hint="Sign In" />


    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="130dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="178dp"
            android:layout_height="100dp"
            android:layout_marginLeft="80dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="150sp"
                android:layout_height="20dp"
                android:layout_marginLeft="50dp"
                android:layout_marginTop="20dp"
                android:textColorHint="@color/white"
                android:text="Don't have account?" />

            <TextView
                android:layout_width="87dp"
                android:layout_height="26dp"
                android:layout_marginLeft="100dp"
                android:text="Sign up"
                android:textColorHint="@color/white"
                android:textSize="20dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/outline_enter" />
    </LinearLayout>


</LinearLayout>

</LinearLayout>